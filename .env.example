VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production
VITE_SITE_URL=https://your-production-domain.example

# Server-only Resend settings. Use a sender address on a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
CONTACT_RECIPIENT_EMAIL=you@example.com

# Server-only Upstash Redis REST credentials for contact-form rate limiting.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token